{
  "name": "litepad",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "description": "极度轻量的 Markdown 文本编辑器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{cjs,mjs}\" eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/*.{cjs,mjs}\" index.html eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/*.{cjs,mjs}\" index.html eslint.config.js",
    "test": "node scripts/run-vitest.cjs",
    "build:all": "bash scripts/build-all.sh",
    "release": "bash scripts/release.sh",
    "doctor": "bash scripts/doctor.sh",
    "screenshot": "bash scripts/shot.sh",
    "clean:tmp": "bash scripts/clean-tmp.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.1",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "@vscode/codicons": "0.0.46-24",
    "codemirror": "^6.0.2",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.9.2",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "^6.4.3",
    "vitest": "~4.1.11"
  }
}
