{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LitePad",
  "version": "0.12.0",
  "identifier": "com.litepad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LitePad",
        "width": 1180,
        "height": 760,
        "minWidth": 560,
        "minHeight": 380,
        "resizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#1b1d1f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "LitePad Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGRjBGOTFFRkE3REE3QUEKUldTcXAzMzZIdm53TDY2MnJhTzA4azhiVnBWLzFXRzhlOUVJcHpPanZhYVVLZWRrS1FOSW5aYWIK",
      "endpoints": [
        "https://github.com/oh-myfun/LitePad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
