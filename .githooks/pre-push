#!/bin/sh
# LitePad pre-push：推送前跑全量测试（前端 vitest + 后端 cargo test）+ **本地构建产出 release exe**
# 激活：git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

# —— 工具链 PATH 兜底 ——
# 干净 shell / git 钩子环境里 PATH 常常不全。与 pre-commit 保持一致：
# 找不到工具链时**警告跳过**，不要报成「测试未通过」——那会把「环境缺工具」
# 误报成「代码有问题」，实测会白白拦住推送。
for d in "$HOME/.cargo/bin" "/c/msys64/mingw64/bin" "C:/msys64/mingw64/bin"; do
  [ -x "$d/cargo.exe" ] && PATH="$d:$PATH"
done
export PATH

# —— coreutils PATH 兜底（grep / sed / head…）——
# ⚠️ 与 pre-commit 同源问题：Git for Windows 的钩子环境不含自带的 `<git>/usr/bin`，
#    而 `scripts/check-version-bump.sh` 内部用 grep/sed/head 统计提交类型。
#    09-18 实测：grep 缺失时该脚本的三处 `grep -cE … || true` 全部返回空 ⇒ 阈值比较变成
#    `[ "" -ge 1 ]`（报 "integer expression expected"）⇒ **版本号守卫静默放行**，
#    看起来「✓ 版本号守卫通过」，实际上根本没统计。注意 msys64/mingw64/bin **没有** grep。
#    层级要**探测**不能算死：官方 Git 是 `<git>/mingw64/libexec/git-core`（退 3 层），
#    部分发行版是 `<git>/libexec/git-core`（退 2 层）；算错一层就静默失效。
#    ⚠️ 命中后必须 `cd … && pwd` **规范化**：带 `..` 的原始路径写进 PATH 后，MSYS 的
#    `command -v` 搜不到（实测把 `<git>/mingw64/libexec/git-core/../../../usr/bin` 塞进 PATH
#    仍然 command not found）。`pwd` 会归一成 `<git>/usr/bin` 才生效。
COREUTILS_DIR=""
EXEC_PATH="$(git --exec-path 2>/dev/null || true)"
for d in "$EXEC_PATH/../../../usr/bin" "$EXEC_PATH/../../usr/bin"; do
  if [ -x "$d/grep.exe" ] || [ -x "$d/grep" ]; then
    COREUTILS_DIR="$(cd "$d" 2>/dev/null && pwd)"
    break
  fi
done
if [ -n "$COREUTILS_DIR" ]; then
  case ":$PATH:" in
  *":$COREUTILS_DIR:"*) ;;
  *) PATH="$COREUTILS_DIR:$PATH" ;;
  esac
  export PATH
  echo "▸ coreutils: $COREUTILS_DIR"
fi

# MSYS2 MinGW64 提供 windres / gcc（工具链见 rust-toolchain.toml）。
# ⚠️ 这段**必须独立存在**，不能挂在「找不到 cargo」的条件里：msys64/mingw64/bin 里并没有
#    cargo.exe，挂进去就等于永不生效 ⇒ tauri-winres 在 build.rs 阶段拿不到 windres，
#    panic `NotAttempted("windres")`，被本钩子误报成「cargo test 未通过」
#    （09-18 push 实测：vitest 458 全绿，cargo 却被这个纯环境问题判红）。
# ⚠️ 别用 `command -v windres` 判断能否用 —— 钩子环境里实测不准；统一用 `-x` 直接测文件。
# ⚠️ 命中后**必须 `cd … && pwd` 归一成 POSIX 形式**（与上面 COREUTILS_DIR 同一条教训）：
#    MSYS 下 `C:/msys64/mingw64/bin` 这种 Windows 风格条目，shell 内 `which` 搜不到，
#    传给**原生**子进程（cargo → build.rs → embed-resource 找 windres）也照样命中不了。
#    09-18 再次实测：候选表第一项 `C:/…` 命中后打印「windres: C:/msys64/mingw64/bin」
#    看起来一切正常，cargo 却仍然 panic NotAttempted("windres")；归一成
#    `/c/msys64/mingw64/bin` 后 40 个 Rust 测试全绿。改这段前先读 regressions 的 B83。
WINDRES_DIR=""
for w in "C:/msys64/mingw64/bin" "/c/msys64/mingw64/bin" "/c/msys64/ucrt64/bin" "/c/msys64/clang64/bin"; do
  if [ -x "$w/windres.exe" ]; then
    WINDRES_DIR="$(cd "$w" 2>/dev/null && pwd)"
    break
  fi
done
if [ -n "$WINDRES_DIR" ]; then PATH="$PATH:$WINDRES_DIR"; export PATH; fi

# 守卫内部靠 grep/sed/head 统计提交类型；缺工具时它会「静默放行」并打印 ✓ —— 假绿。
# 这类门绝不能靠「看起来通过」，缺工具就硬失败。
for t in grep sed head bash; do
  command -v "$t" >/dev/null 2>&1 || {
    echo "✗ pre-push 失败：找不到 $t（Git 自带的 usr/bin 也没有）" >&2
    echo "  版本号守卫会因缺工具静默放行，拒绝继续。" >&2
    exit 1
  }
done

echo "▸ 版本号守卫（feat 未 bump / 有效提交超阈值即阻断，口径见 docs/conventions.md）"
bash scripts/check-version-bump.sh || {
  echo "✗ pre-push 失败：版本号未按规则 bump" >&2
  exit 1
}

echo "▸ vitest 全量"
node node_modules/vitest/vitest.mjs run || {
  echo "✗ pre-push 失败：vitest 未通过" >&2
  exit 1
}

# ⚠️ 09-23：工具链切到 MSVC 后，cargo test **不再需要 windres**（资源编译改由 Windows SDK 的
#   rc.exe 承担）。原来「找不到 windres ⇒ 跳过 cargo test」的分支，会让 Rust 侧完全不校验
#   而钩子退出码仍是 0 —— 典型的静默假绿（本项目第 N 次栽在「退出码 0 ≠ 真校验」上）。
#   改成按工具链分流：msvc 直接跑，gnu 才需要 windres。
TOOLCHAIN_IS_MSVC=0
if [ -f rust-toolchain.toml ] && grep -q 'windows-msvc' rust-toolchain.toml 2>/dev/null; then
  TOOLCHAIN_IS_MSVC=1
fi

if [ -x "$HOME/.cargo/bin/cargo.exe" ] || command -v cargo >/dev/null 2>&1; then
  if [ "$TOOLCHAIN_IS_MSVC" = "1" ] || [ -n "$WINDRES_DIR" ]; then
    if [ "$TOOLCHAIN_IS_MSVC" = "1" ]; then
      echo "▸ cargo test --release（toolchain: msvc，无需 windres）"
    else
      echo "▸ cargo test --release（windres: $WINDRES_DIR）"
    fi
    (cd src-tauri && cargo test --release) || {
      echo "✗ pre-push 失败：cargo test 未通过" >&2
      exit 1
    }
  else
    echo "⚠ 找不到 windres（MSYS2 MinGW64），跳过 cargo test —— Rust 侧未校验" >&2
    echo "  修：把 MSYS2 的 mingw64/bin 放进 PATH（工具链见 rust-toolchain.toml）" >&2
  fi
else
  echo "⚠ 找不到 cargo，跳过 cargo test（Rust 侧未校验）" >&2
fi

# —— 本地构建：前端 dist + release exe（09-20 用户要求：推送前先本地编译并生成 exe）——
# ⚠️ 为什么必须有这一段（两段理由，第二条更隐蔽）：
#   ① 「能不能编译出来」不该只由 CI 判断 —— 推上去等 CI 变红再回来修，一轮来回几十分钟。
#   ② **连带损失：截图刷不了**。`scripts/capture-screenshots.py` 的前置就是
#      `src-tauri/target/release/litepad.exe`；而发布走 `release.sh <ver> --ci` 会跳过本地构建，
#      exe 停在旧版本 ⇒ `docs/screenshots/main.png` 无米下锅 ⇒ 「界面改动必刷截图」这条红线落空
#      （v0.7.0 / v0.8.0 连续两个版本因此漏刷，09-20 复盘才定位到）。有这一段，exe 每次推送都是新的。
# ⚠️ vite 清空 `dist/assets` 会触发本会话的 safe-delete 钩子 → 必须关掉（与 build-all.sh 同一条）。
# ⚠️ `beforeBuildCommand` 必须置空：上面已单独跑过 `npm run build`，否则 tauri 会把 vite 再跑一遍
#    （build-all.sh 里那次「vite 卡死 + dist 只写一半」就出在重复构建上）。
if command -v npm >/dev/null 2>&1 && { [ -x "$HOME/.cargo/bin/cargo.exe" ] || command -v cargo >/dev/null 2>&1; }; then
  echo "▸ 本地构建（tsc + vite → dist，再嵌入前端生成 release exe）"
  export CODEBUDDY_SAFE_DELETE_ENABLED=0
  # ⚠️ **vite 必须在「不含 MSYS2 条目」的 PATH 下跑**，否则会挂死（09-20 实测坐实）：
  #    上面为给 cargo 提供 windres 把 `/c/msys64/mingw64/bin` 加进了 PATH，而 PATH 里带它时
  #    `vite build` 表现为——CPU 只走 25s 就不动、内存涨到 1.8G、`dist/assets` 被清空后
  #    始终不写入，挂 13 分钟也不出产物（同一指纹 09-19 在 build-all.sh 里出现过两次，
  #    当时只记为「疑点未定论」）。去掉这些条目后同一条命令 **40s** 完成。
  #    Rust 侧确实需要 windres，所以只在这一步**临时**摘掉，跑完 PATH 自动恢复。
  FE_PATH=""
  OLDIFS="$IFS"
  IFS=":"
  for d in $PATH; do
    case "$d" in
    *msys64*) ;;
    *) FE_PATH="${FE_PATH:+$FE_PATH:}$d" ;;
    esac
  done
  IFS="$OLDIFS"
  # ⚠️ 第二层兜底：**vite 会间歇性挂死**，光靠剥离 PATH 挡不住。09-20 钩子内实测：
  #    已经剥离过 MSYS2 条目，仍然卡在「✓ 2667 modules transformed」之后的写盘阶段不动，
  #    内存涨到 ~1.7G（同一指纹手动跑时又是 71s 正常完成）→ 是**概率性**问题。
  #    所以加超时 + 重试一次：卡住就杀掉重来，仍卡住才判失败（不会把推送无限期挂起）。
  #    `timeout -k` 是必须的：只发 TERM 时 npm 未必带走 node 子进程，会留下孤儿继续吃内存。
  #    `timeout` 本身若不存在（极简环境）就退化为不超时，别让「缺 coreutils」挡住推送。
  TO=""
  if command -v timeout >/dev/null 2>&1; then TO="timeout -k 10 240"; fi
  BUILD_OK=0
  for attempt in 1 2; do
    if PATH="$FE_PATH" $TO npm run build; then
      BUILD_OK=1
      break
    fi
    echo "⚠ 前端构建第 ${attempt} 次失败或超时（vite 会间歇性挂死，见 pitfalls/0085），重试…" >&2
  done
  if [ "$BUILD_OK" != 1 ]; then
    echo "✗ pre-push 失败：前端构建（tsc + vite）未通过（已重试 1 次）" >&2
    exit 1
  fi
  # 缺 makensis 就只出 exe（--no-bundle）：「没有安装包工具」不该挡住推送，exe 才是硬需求
  BUNDLE_FLAG=""
  if ! [ -x "$HOME/AppData/Local/tauri/NSIS/makensis.exe" ] && ! command -v makensis >/dev/null 2>&1; then
    echo "⚠ 找不到 makensis（NSIS），改用 --no-bundle：只生成 exe，不出安装包" >&2
    BUNDLE_FLAG="--no-bundle"
  fi
  npm run tauri -- build $BUNDLE_FLAG --config '{"build":{"beforeBuildCommand":""}}' || {
    echo "✗ pre-push 失败：release 构建未通过（未产出 exe）" >&2
    exit 1
  }
  # ⚠️ 别只看退出码：构建命令返回 0 却没写出 exe 的情况出现过（产物被占用/写一半）。
  EXE="src-tauri/target/release/litepad.exe"
  if [ ! -f "$EXE" ]; then
    echo "✗ pre-push 失败：构建命令返回 0，但 $EXE 不存在" >&2
    exit 1
  fi
  echo "  ✓ $EXE（$(date -r "$EXE" '+%F %H:%M')，$(wc -c < "$EXE") 字节）"
else
  echo "⚠ 找不到 npm 或 cargo，跳过本地构建（未生成 exe：前端/Rust 产物均未校验）" >&2
fi

echo "✓ pre-push 通过"
